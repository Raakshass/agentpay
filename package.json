{
  "name": "conduit",
  "version": "0.1.0",
  "private": true,
  "description": "State channel payment gateway for AI agents to consume DePIN and Web3 API data on Solana.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:gateway": "pnpm --filter @conduit/gateway run dev",
    "build": "pnpm --filter './packages/**' run build",
    "test": "pnpm --filter './packages/**' run test",
    "typecheck": "pnpm --filter './packages/**' run typecheck",
    "clean": "pnpm --filter './packages/**' run clean"
  }
}
