# =============================================================================
# AgentPay — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit the .env file itself.
# =============================================================================

# --- Solana Network ---
SOLANA_NETWORK=devnet
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# --- Gateway Server ---
GATEWAY_PORT=4020
GATEWAY_HOST=0.0.0.0

# --- Gateway Wallet (signs settlement transactions) ---
GATEWAY_WALLET_PRIVATE_KEY=
GATEWAY_REVENUE_WALLET_ADDRESS=

# --- Session Defaults ---
SESSION_TIMEOUT_SECONDS=3600
SESSION_MAX_DEPOSIT_USDC=100

# --- USDC Configuration ---
USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# --- Upstream API Keys ---
OPENWEATHERMAP_API_KEY=
HELIUS_API_KEY=

# --- Contract Program IDs (filled after Vineet deploys) ---
ESCROW_PROGRAM_ID=
REGISTRY_PROGRAM_ID=
