# =============================================================================
# AgentPay — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit the .env file itself.
# =============================================================================

# --- Solana Network ---
SOLANA_NETWORK=devnet
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# --- Gateway Server ---
GATEWAY_PORT=4020
GATEWAY_HOST=0.0.0.0

# --- Gateway Wallet ---
# Signs settlement transactions. Format: JSON byte array from Solana CLI.
# Generate with: solana-keygen new --outfile gateway-keypair.json
# Then paste the file contents here, e.g. [23,45,67,...]
GATEWAY_WALLET_PRIVATE_KEY=
GATEWAY_REVENUE_WALLET_ADDRESS=

# --- Session Defaults ---
SESSION_TIMEOUT_SECONDS=3600
SESSION_MAX_DEPOSIT_USDC=100

# --- USDC Configuration ---
# Devnet test mint — replace with real USDC mint for mainnet
USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# --- Upstream API Keys ---
OPENWEATHERMAP_API_KEY=
HELIUS_API_KEY=

# --- Contract Program IDs ---
# Fill these after deploying the Anchor programs to devnet.
# The settle instruction in settlement.ts requires ESCROW_PROGRAM_ID.
ESCROW_PROGRAM_ID=8vH1iEpbwe31WGqSGd9a8qkKh7SCHW8MsaSULVsxskRw
REGISTRY_PROGRAM_ID=XGXadfKb7mru5wcr1yUZWSeBLVUY6NFDAriBUUMiLbk
