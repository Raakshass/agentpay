# Conduit web — environment variables
# Copy to `.env.local` and adjust. All vars are exposed to the browser, so use
# only public values (NEXT_PUBLIC_ prefix is required for client access).

# Solana cluster: "devnet" or "mainnet-beta"
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# RPC endpoint. The public devnet RPC is rate-limited; use a Helius/QuickNode
# URL for anything real.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# On-chain program IDs (defaults match the committed Anchor sources).
NEXT_PUBLIC_REGISTRY_PROGRAM_ID=XGXadfKb7mru5wcr1yUZWSeBLVUY6NFDAriBUUMiLbk
NEXT_PUBLIC_ESCROW_PROGRAM_ID=8vH1iEpbwe31WGqSGd9a8qkKh7SCHW8MsaSULVsxskRw

# USDC mint used for pricing/settlement (devnet test mint by default).
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Gateway HTTP base URL (used in the catalog "Try it" snippet).
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4020

# Optional: gateway WebSocket URL. When set, the live demo streams real
# settlement events instead of simulated ones. Leave blank for simulated mode.
NEXT_PUBLIC_GATEWAY_WS_URL=
